# People.ai Query API credentials (from your Backstory admin).
# Variable names match what the Python scripts expect.
PEOPLEAI_CLIENT_ID=
PEOPLEAI_CLIENT_SECRET=

# People.ai API base URL (default used by all scripts).
PEOPLEAI_API_BASE=https://api.people.ai

# Backstory MCP URL (used for interactive OAuth connection in Claude CLI).
# Configure with: claude mcp add --transport http peopleai https://mcp.people.ai/mcp
BACKSTORY_MCP_URL=https://mcp.people.ai/mcp
